    "@vuepress/plugin-links-check": "2.0.0-rc.128",
    "@vuepress/plugin-llms": "2.0.0-rc.128",
    "@vuepress/plugin-revealjs": "2.0.0-rc.128",
    "@vuepress/plugin-slimsearch": "2.0.0-rc.129",
    "@vueuse/core": "^14.2.1",
    "date-fns": "^4.1.0",
    "http-server": "^14.1.1",

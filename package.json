  "license": "MIT",
  "scripts": {
    "docs:build": "node scripts/check-permalink-conflicts.mjs && vuepress build docs --clean-cache --clean-temp && npx -y pagefind --site docs/.vuepress/dist",
    "docs:dev": "vuepress dev docs",
    "docs:dev-clean": "vuepress dev docs --clean-cache --clean-temp",
    "docs:preview": "http-server docs/.vuepress/dist",
    "vp-update": "pnpm dlx vp-update",
    "up": "bun update -i",
    "up:safe": "node scripts/safe-update.mjs",
    "page-find": "npx -y pagefind --site docs/.vuepress/dist --serve",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "test": "vitest run"
  },

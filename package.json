    "tdesign-mobile-vue": "^1.13.2",
    "typescript": "^5.9.3",
    "vfonts": "^0.0.3",
    "vitest": "^3.2.1",
    "vue": "3.5.32",
    "vuepress": "2.0.0-rc.28",
    "vuepress-theme-plume": "1.0.0-rc.196"

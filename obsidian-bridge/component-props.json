    {
      "name": "DirectoryLevel",
      "tag": "<DirectoryLevel",
      "props": [],
      "fallback": {
        "tag": "div",
        "class": "sillot-directory-level"
      }
    },
    {
      "name": "IndexMe",
      "tag": "<IndexMe",
      "props": [],
      "fallback": {
        "tag": "div",
        "class": "sillot-index-me"
      }
    },
    {
      "name": "C",
      "tag": "<C",
      "props": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "description": "Cedoss 组件 ID"
        }
      ],
      "fallback": {
        "tag": "span",
        "class": "sillot-cedoss-ref",
        "contentFrom": "id"
      }
